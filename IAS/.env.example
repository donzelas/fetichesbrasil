# =====================================================================
# IAS - Fetiches Brasil - Variaveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env no Git.
# =====================================================================

# ============ APIS EXTERNAS - LLM ============

# Groq (LLM principal) - https://console.groq.com
# Gratuito: 30 req/min, 14.400 req/dia
GROQ_API_KEY=

# Google Gemini (fallback) - https://aistudio.google.com/apikey
# Gratuito: 15 req/min, 1.500 req/dia
GEMINI_API_KEY=

# ============ APIS EXTERNAS - B-ROLL ============

# Pexels API - https://www.pexels.com/api/
# Gratuito: 200 req/hora
PEXELS_API_KEY=

# Pixabay API (fallback) - https://pixabay.com/api/docs/
# Gratuito: 100 req/60s
PIXABAY_API_KEY=

# ============ TIKTOK CONTENT POSTING API ============
# https://developers.tiktok.com
# Comece pelo "Inbox" (sem auditoria), depois solicite "Direct Post"
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ============ APROVACAO VIA PAINEL ADMIN /admin/tiktok ============
# Webhook que o site Fetiches Brasil chama quando admin aprova um roteiro.
# Configure no n8n um "Webhook Trigger" e use a URL+secret aqui.
# Tambem adicione N8N_TIKTOK_WEBHOOK_URL e N8N_WEBHOOK_SECRET no .env do site.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/tiktok-pipeline
N8N_WEBHOOK_SECRET=

# ============ SUPABASE (state, scripts, metricas) ============
# Use as MESMAS keys do projeto principal Fetiches Brasil
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============ BACKBLAZE B2 (backup de mp4s, opcional) ============
# https://www.backblaze.com/cloud-storage
# Gratuito: 10 GB
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=fetiches-tiktok

# ============ N8N ============
# Senha forte para login web no n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-essa-senha-forte

# Encryption key - gere com: openssl rand -base64 32
# Ou PowerShell: [Convert]::ToBase64String((1..32 | %{Get-Random -Max 256}))
N8N_ENCRYPTION_KEY=troque-por-string-aleatoria-32-bytes

# ============ POSTIZ ============
POSTIZ_JWT_SECRET=troque-por-outra-string-aleatoria-longa
POSTIZ_DATABASE_URL=postgresql://postiz:postiz@postiz-db:5432/postiz
POSTIZ_REDIS_URL=redis://postiz-redis:6379

# ============ DOMINIOS (Cloudflare Tunnel) ============
# Configure depois de comprar o dominio e criar o tunnel
DOMAIN_BASE=seudominio.xyz
N8N_DOMAIN=n8n.seudominio.xyz
POSTIZ_DOMAIN=postiz.seudominio.xyz
WHISPER_DOMAIN=whisper.seudominio.xyz
UPTIME_DOMAIN=uptime.seudominio.xyz
