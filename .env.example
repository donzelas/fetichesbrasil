# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Service role (somente server-side, NUNCA expor no client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron secret (proteja a rota /api/cron/snapshot-presence)
CRON_SECRET=troque-por-uma-string-aleatoria-segura

# Mercado Pago (obrigatório para vender Premium via PIX)
# Painel: https://www.mercadopago.com.br/developers/panel
# Use TEST-... em dev (cria usuários de teste no painel)
# Public Key — pode ir no client se algum dia for usar Bricks
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Access Token — SECRETO, só server. Usado para criar Preferences e ler Payments.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
# Webhook signing secret — gere em "Notificações" do app no painel MP
# https://www.mercadopago.com.br/developers/panel/app/SEU_APP_ID/webhooks
MP_WEBHOOK_SECRET=cole-aqui-o-secret-do-webhook

# IAS - Sistema de automação TikTok (pasta IAS/)
# Webhook do n8n rodando no notebook 24/7. Acionado quando admin
# aprova um roteiro em /admin/tiktok
# Use Cloudflare Tunnel para expor o n8n publicamente.
N8N_TIKTOK_WEBHOOK_URL=https://n8n.seudominio.com.br/webhook/tiktok-pipeline
N8N_WEBHOOK_SECRET=use-a-mesma-string-do-IAS/.env
