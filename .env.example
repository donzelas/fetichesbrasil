# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Service role (somente server-side, NUNCA expor no client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron secret (proteja a rota /api/cron/snapshot-presence)
CRON_SECRET=troque-por-uma-string-aleatoria-segura

# Stripe (obrigatório se for vender Premium)
# Pegue em https://dashboard.stripe.com/apikeys (use TEST em dev)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Crie um webhook em https://dashboard.stripe.com/webhooks
# URL: https://SEU_DOMINIO/api/stripe/webhook
# Eventos: checkout.session.completed, customer.subscription.deleted,
# customer.subscription.updated, invoice.payment_succeeded,
# invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
